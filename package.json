{
  "name": "rabotabybot",
  "version": "0.1.0",
  "description": "Telegram bot that notifies about Rabota.by replies found in Gmail",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konstantin7200/RabotaByBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Konstantin7200/RabotaByBot/issues"
  },
  "homepage": "https://github.com/Konstantin7200/RabotaByBot#readme",
  "dependencies": {
    "@googleapis/gmail": "^22.0.1",
    "croner": "^10.0.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "email-addresses": "^5.0.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "grammy": "^1.46.0",
    "html-to-text": "^10.0.1",
    "jose": "^5.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3"
  }
}
