# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
# Public HTTPS origin of this deployment (no trailing slash).
# Used for the Telegram webhook URL and the Pub/Sub push OIDC audience.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Telegram ---
# Bot token from @BotFather
TG_BOT_TOKEN=123456789:replace-with-botfather-token
# Random long string verified against X-Telegram-Bot-Api-Secret-Token
# on POST /telegram/webhook. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random

# --- Google OAuth / Gmail ---
# OAuth client ID from Google Cloud console (Gmail API enabled)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me
# Must exactly match a redirect URI registered in the Google Cloud console
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/oauth/callback
# Pub/Sub topic that Gmail watch pushes to. The topic must grant
# roles/pubsub.publisher to gmail-api-push@system.gserviceaccount.com
GOOGLE_TOPIC_NAME=projects/your-project/topics/rabota-by

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Security ---
# 32 bytes as 64 hex characters. Generate: openssl rand -hex 32
# Used for AES-256-GCM encryption of stored Gmail refresh tokens.
# Deploy note (fresh start): tokens written before encryption existed are
# treated as invalid; those users re-link via /start.
TOKEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# --- Optional behavior ---
# Comma-separated subject substrings for the Rabota.by response-template gate.
# Empty/absent (default) = notify on any letter from the rabota.by domain.
# UNCONFIRMED: real Rabota.by subjects are not verified yet (assignment §6.3).
# RABOTA_SUBJECT_PATTERNS=ответ на отклик,вакансия
